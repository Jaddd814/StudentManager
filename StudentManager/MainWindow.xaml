<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner Header -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Manage student data" Foreground="White" FontSize="14" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Form Input & Info Panel -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="NIM" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Nama" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Jurusan" FontWeight="Bold"/>
                <ComboBox SelectedItem="{Binding SelectedStudent.Jurusan}" Margin="0,0,0,10" Padding="5">
                    <ComboBoxItem Content="Informatika"/>
                    <ComboBoxItem Content="Sistem Informasi"/>
                </ComboBox>

                <TextBlock Text="Gender" FontWeight="Bold"/>
                <ComboBox SelectedItem="{Binding SelectedStudent.Gender}" Margin="0,0,0,10" Padding="5">
                    <ComboBoxItem Content="Laki-laki"/>
                    <ComboBoxItem Content="Perempuan"/>
                </ComboBox>

                <TextBlock Text="Email" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Simpan" Command="{Binding SaveCommand}" Background="#1976D2" Foreground="White" Padding="20,8" Margin="0,0,10,0"/>
                    <Button Content="Hapus" Command="{Binding DeleteCommand}" Background="#D32F2F" Foreground="White" Padding="20,8" Margin="0,0,10,0"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Padding="20,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Panel Statistik -->
            <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="INFORMASI" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Total Mahasiswa" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalStudents}" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Informatika" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalInformatika}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="Sistem Informasi" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="Laki-laki" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalLakiLaki}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="Perempuan" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalPerempuan}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="8" Margin="0,0,10,0"/>
            <Button Content="Cari" Command="{Binding SearchCommand}" Padding="25,8"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="150"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="250"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="200"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>